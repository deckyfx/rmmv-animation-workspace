# Docker Compose Configuration
# This file is ONLY used when running with docker-compose
# For local development (bun run dev), use packages/studio/.env instead

# Server Port (inside Docker container)
# The port the application listens on inside the container
SERVER_PORT=3000

# External port (exposed to host)
# The port accessible from outside Docker (mapped to SERVER_PORT)
OUTBOUND_PORT=10021
